{
    "schemaVersion": 1,
    "id": "expressionmod",
    "version": "${version}",
    "name": "Expression Mod",
    "description": "プレイヤーの表情・視線挙動・頭部回転を制御するMOD。ショートカットキーでエモートを発動し、人間らしい目の動きを実現します。",
    "authors": [
        "R41R41"
    ],
    "license": "CC0-1.0",
    "icon": "assets/expressionmod/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.expression.ExpressionMod"
        ],
        "client": [
            "com.expression.ExpressionModClient"
        ],
        "modmenu": [
            "com.expression.ModMenuIntegration"
        ]
    },
    "mixins": [
        "expressionmod.mixins.json",
        {
            "config": "expressionmod.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.18.5",
        "minecraft": "~26.1",
        "java": ">=25",
        "fabric-api": "*"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.gg/example"
            }
        }
    }
}
